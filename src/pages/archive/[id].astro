---
import IdLayout from "@/layouts/IdLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const items = (await getCollection("archive")).sort((a, b) =>
        a.id.localeCompare(b.id)
    );

    return items.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const allItems = (await getCollection("archive")).sort((a, b) =>
    a.id.localeCompare(b.id)
);
const currentIndex = allItems.findIndex((i) => i.id === item.id);

const prev =
    currentIndex > 0 ? allItems[currentIndex - 1] : null;

const next =
    currentIndex < allItems.length - 1
        ? allItems[currentIndex + 1]
        : null;
---

<IdLayout
    type="archive"
    title={item.data.title}
    description={item.body}
    image={item.data.image}
    prev={prev}
    next={next}
>
    <article transition:animate="fade">
        <div class="mb-6">
            <a
                href="/archive"
                class="text-sm text-muted-foreground hover:text-foreground animation"
            >
                ← archive
            </a>
        </div>

        <div class="border border-border overflow-hidden">
            <img
                src={item.data.image}
                alt={item.data.title}
                class="block w-full h-auto"
            />
        </div>

        <div class="mt-8 border border-border p-6">
            <div class="whitespace-pre-line text-base leading-relaxed">
                <Content />
            </div>

            {
                item.data.hashtags.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
                        {item.data.hashtags.map((tag) => (
                            <span
                                class="text-sm text-muted-foreground"
                            >
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
    </article>
</IdLayout>
