---
import IdLayout from "@/layouts/IdLayout.astro";
import { getCollection, render } from "astro:content";
import { sortArchiveItems } from "@/lib/archive-sort";

export async function getStaticPaths() {
    const items = sortArchiveItems(await getCollection("archive"));

    return items.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const allItems = sortArchiveItems(await getCollection("archive"));
const currentIndex = allItems.findIndex((i) => i.id === item.id);

const prev =
    currentIndex > 0 ? allItems[currentIndex - 1] : null;

const next =
    currentIndex < allItems.length - 1
        ? allItems[currentIndex + 1]
        : null;
---

<IdLayout
    type="archive"
    title={item.data.title}
    description={item.body}
    image={item.data.image}
    prev={prev}
    next={next}
>
    <article transition:animate="fade">
        <div class="mb-6">
            <a
                href="/archive"
                class="text-sm text-muted-foreground hover:text-foreground animation"
            >
                ← archive
            </a>
        </div>

        <div class="border border-border overflow-hidden">
            <img
                src={item.data.image}
                alt={item.data.title}
                class="block w-full h-auto"
            />
        </div>

        <div class="mt-8 border border-border p-6">
            <div class="whitespace-pre-line text-base leading-relaxed text-center px-20">
                <Content />
            </div>

            {item.data.x_id && (
                <div class="mt-8 border-t border-border pt-6 text-center">
                    <a
                        href={`https://x.com/PEKHTography/status/${item.data.x_id}`}
                        target="_blank"
                        rel="nofollow noopener noreferrer"
                        class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                    >
                        Original publication
                    </a>
                </div>
            )}

        </div>
    </article>
</IdLayout>
