---
import { getCollection } from "astro:content";
import { sortArchiveItems } from "@/lib/archive-sort";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { ArchiveCard } from "@/components/client/ArchiveCard";
import { RiArrowLeftSLine, RiArrowRightSLine } from "@remixicon/react";

export async function getStaticPaths({ paginate }) {
    const items = sortArchiveItems(await getCollection("archive"));

    return paginate(items, {
        pageSize: 48,
    });
}

const { page } = Astro.props;
const items = page.data;
const allItems = sortArchiveItems(await getCollection("archive"));
const archiveCount = allItems.length;
---

<IndexLayout
    title="Archive - PEKHTOGRAPHY"
    description="A visual archive of photographs, fragments, light, color, and moments."
    image="/og/default.png"
>
    <div transition:animate="fade">
        <IndexHeader
            url="/"
            heading="Archive"
            description={`${archiveCount} observations.\nPhotographs and fragments from encounters with the everyday world.`}
            variant="archive"
        />

        <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-6">
            {
                items.map((item) => (
                    <ArchiveCard item={item} />
                ))
            }
        </div>

        <nav class="mt-10 flex items-center justify-between border border-border p-4">
            {
                page.url.prev ? (
                    <a
                        href={page.url.prev}
                        aria-label="Previous archive page"
                        class="inline-flex size-8 shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] border border-border bg-background shadow-xs hover:bg-muted hover:text-foreground transition-all active:scale-95"
                    >
                        <RiArrowLeftSLine className="size-5 fill-muted-foreground" />
                    </a>
                ) : (
                    <span class="size-8" />
                )
            }

            <span class="text-sm text-muted-foreground">
                {page.currentPage} / {page.lastPage}
            </span>

            {
                page.url.next ? (
                    <a
                        href={page.url.next}
                        aria-label="Next archive page"
                        class="inline-flex size-8 shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] border border-border bg-background shadow-xs hover:bg-muted hover:text-foreground transition-all active:scale-95"
                    >
                        <RiArrowRightSLine className="size-5 fill-muted-foreground" />
                    </a>
                ) : (
                    <span class="size-8" />
                )
            }
        </nav>
    </div>
</IndexLayout>
