---
import { getCollection } from "astro:content";
import { ARCHIVE_PAGE_SIZE, sortArchiveItems } from "@/lib/archive-sort";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { ArchiveCard } from "@/components/client/ArchiveCard";
import { RiArrowLeftSLine, RiArrowRightSLine } from "@remixicon/react";

export async function getStaticPaths({ paginate }) {
    const items = sortArchiveItems(await getCollection("archive"));

    return paginate(items, {
        pageSize: ARCHIVE_PAGE_SIZE,
    });
}

const { page } = Astro.props;
const items = page.data;
const allItems = sortArchiveItems(await getCollection("archive"));
const archiveCount = allItems.length;

const currentPage = page.currentPage;
const lastPage = page.lastPage;

const activeStart = Math.max(
    1,
    Math.min(currentPage - 2, lastPage - 4),
);
const activeEnd = Math.min(lastPage, activeStart + 4);
const activePages = Array.from(
    { length: activeEnd - activeStart + 1 },
    (_, index) => activeStart + index,
);

const anchorPages = Array.from(
    { length: 4 },
    (_, index) =>
        Math.round(1 + ((lastPage - 1) * index) / 3),
);

const paginationPages = Array.from(
    new Set([...anchorPages, ...activePages]),
).sort((a, b) => a - b);

const pageUrl = (pageNumber: number) =>
    pageNumber === 1 ? "/archive" : `/archive/${pageNumber}`;
---

<IndexLayout
    title="Archive - PEKHTOGRAPHY"
    description="A visual archive of photographs, fragments, light, color, and moments."
    image="/og/default.png"
>
    <div transition:animate="fade">
        <IndexHeader
            url="/"
            heading="Archive"
            description={`${archiveCount} observations.\nPhotographs and fragments from encounters with the everyday world.`}
            variant="archive"
        />

        <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-6">
            {
                items.map((item) => (
                    <ArchiveCard item={item} />
                ))
            }
        </div>

        <nav class="mt-10 flex items-center justify-between border border-border p-4">
            {
                page.url.prev ? (
                    <div class="group flex items-center gap-2">
                        <a
                            href={page.url.prev}
                            aria-label="Previous archive page"
                            class="inline-flex size-8 shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] border border-border bg-background shadow-xs hover:bg-muted hover:text-foreground transition-all active:scale-95"
                        >
                            <RiArrowLeftSLine className="size-5 fill-muted-foreground" />
                        </a>
                        <span class="pointer-events-none text-sm text-muted-foreground opacity-0 -translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all">
                            previous
                        </span>
                    </div>
                ) : (
                    <span class="size-8" />
                )
            }

            <div class="flex items-center gap-1">
                {
                    paginationPages.map((pageNumber, index) => {
                        const previousPage = paginationPages[index - 1];
                        const showEllipsis = index > 0 && pageNumber - previousPage > 1;

                        return (
                            <>
                                {showEllipsis && (
                                    <span class="px-1 text-sm text-muted-foreground select-none">
                                        …
                                    </span>
                                )}
                                <a
                                    href={pageUrl(pageNumber)}
                                    aria-current={pageNumber === currentPage ? "page" : undefined}
                                    class:list={[
                                        "inline-flex size-8 shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] border border-border text-sm transition-all active:scale-95",
                                        pageNumber === currentPage
                                            ? "bg-secondary text-secondary-foreground"
                                            : "bg-background text-muted-foreground shadow-xs hover:bg-muted hover:text-foreground",
                                    ]}
                                >
                                    {pageNumber}
                                </a>
                            </>
                        );
                    })
                }
            </div>

            {
                page.url.next ? (
                    <div class="group flex items-center gap-2">
                        <span class="pointer-events-none text-sm text-muted-foreground opacity-0 translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 transition-all">
                            next
                        </span>
                        <a
                            href={page.url.next}
                            aria-label="Next archive page"
                            class="inline-flex size-8 shrink-0 items-center justify-center rounded-[min(var(--radius-md),10px)] border border-border bg-background shadow-xs hover:bg-muted hover:text-foreground transition-all active:scale-95"
                        >
                            <RiArrowRightSLine className="size-5 fill-muted-foreground" />
                        </a>
                    </div>
                ) : (
                    <span class="size-8" />
                )
            }
        </nav>
    </div>
</IndexLayout>
