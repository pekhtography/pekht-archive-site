---
import FilterBlog from "@/components/client/FilterBlog";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { getCollection } from "astro:content";
import { parse } from "date-fns";

const blogItems = await getCollection("blog");
const journalItems = blogItems
    .filter((blog) => !blog.data.draft && blog.data.category === "journal")
    .sort((a, b) => {
        const aDate = parse(a.data.date, "dd-MM-yyyy", new Date());
        const bDate = parse(b.data.date, "dd-MM-yyyy", new Date());
        return bDate.getTime() - aDate.getTime();
    });

const legacySamples = blogItems.filter(
    (blog) =>
        !blog.data.draft &&
        ["markdown-showcase", "aureus-cli-automation"].includes(blog.id),
);

const allItems = [...journalItems, ...legacySamples];
---

<IndexLayout title="Journal - PEKHTOGRAPHY" description="Editorial passages assembled from the archive." image="/og/default.png">
    <div transition:animate="fade">
        <IndexHeader url="/" heading="Journal" description="Editorial passages assembled from the archive." />

        <div class="mt-3">
            <FilterBlog client:load items={allItems} />
        </div>
    </div>
</IndexLayout>
