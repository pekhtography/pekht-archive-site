---
import FilterBlog from "@/components/client/FilterBlog";
import IndexHeader from "@/components/static/IndexHeader.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { getCollection } from "astro:content";
import { parse } from "date-fns";

const journalSourceIds = new Set<string>();

const blogItems = await getCollection("blog");
const archiveItems = await getCollection("archive");
const archiveById = new Map(archiveItems.map((archive) => [archive.id, archive]));

const journalItems = blogItems
    .filter((blog) => !blog.data.draft && blog.data.category === "journal")
    .sort((a, b) => {
        const aDate = parse(a.data.date, "dd-MM-yyyy", new Date());
        const bDate = parse(b.data.date, "dd-MM-yyyy", new Date());
        return bDate.getTime() - aDate.getTime();
    });

for (const item of journalItems) {
    for (const sourceId of item.data.source_ids ?? []) {
        journalSourceIds.add(sourceId);
    }

    for (const block of item.data.composition ?? []) {
        if (block.type === "source") journalSourceIds.add(block.source_id);
    }
}

const journalSourceDates = [...journalSourceIds]
    .map((sourceId) => archiveById.get(sourceId)?.data.x_created_at)
    .filter((createdAt): createdAt is string => Boolean(createdAt))
    .map((createdAt) => new Date(createdAt))
    .filter((date) => !Number.isNaN(date.getTime()))
    .sort((a, b) => a.getTime() - b.getTime());

const journalSinceDate = journalSourceDates[0]?.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});

const journalDescription = `Photographs and words, composed into stories.\\nA growing collection — ${journalItems.length} ${journalItems.length === 1 ? "story has" : "stories have"} found their way here${journalSinceDate ? ` since ${journalSinceDate}` : ""}.`;

const allItems = journalItems.map((item) => {
    const firstCompositionSource = item.data.composition?.find((block) => block.type === "source");
    const firstSourceId = firstCompositionSource?.source_id ?? item.data.source_ids?.[0];
    const previewImage = firstSourceId ? archiveById.get(firstSourceId)?.data.image : undefined;

    if (!previewImage) {
        throw new Error(`Journal entry "${item.id}" has no resolvable first archive image.`);
    }

    return { ...item, previewImage };
});
---

<IndexLayout title="Journal - PEKHTOGRAPHY" description={journalDescription} image="/og/default.png">
    <div transition:animate="fade">
        <IndexHeader url="/" heading="Journal" description={journalDescription} variant="journal" />

        <div class="mt-3">
            <FilterBlog client:load items={allItems} />
        </div>
    </div>
</IndexLayout>
