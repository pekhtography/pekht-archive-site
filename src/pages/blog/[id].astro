---
import IdHeader from "@/components/static/IdHeader.astro";
import JournalComposition from "@/components/static/JournalComposition.astro";
import IdLayout from "@/layouts/IdLayout.astro";
import { getCollection, render } from "astro:content";
import { parse } from "date-fns";

export async function getStaticPaths() {
    const items = await getCollection("blog");
    const journalItems = items.filter((item) => !item.data.draft && item.data.category === "journal");
    const legacySamples = items.filter(
        (item) =>
            !item.data.draft &&
            ["markdown-showcase", "aureus-cli-automation"].includes(item.id),
    );
    const pages = [...journalItems, ...legacySamples];

    return pages.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const isJournal = item.data.category === "journal";
const archiveItems = await getCollection("archive");

const allItems = (await getCollection("blog"))
    .filter((item) => !item.data.draft && item.data.category === "journal")
    .sort((a, b) => {
        const dateA = parse(a.data.date, "dd-MM-yyyy", new Date());
        const dateB = parse(b.data.date, "dd-MM-yyyy", new Date());
        return dateA.getTime() - dateB.getTime();
    });

const currentIndex = allItems.findIndex((i) => i.id === item.id);
const prev = currentIndex > 0 ? allItems[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < allItems.length - 1 ? allItems[currentIndex + 1] : null;

const pubDate = parse(item.data.date, "dd-MM-yyyy", new Date());
---

<IdLayout
    type="blog"
    title={item.data.title}
    description={item.data.description}
    image={`/og/blog/${item.id}.png`}
    pubDate={pubDate}
    author={item.data.author}
    tags={item.data.tags}
    prev={prev}
    next={next}
>
    <article transition:animate="fade" class={isJournal ? "journal-entry" : ""}>
        <IdHeader backUrl="/blog" items={item.data} />

        {
            isJournal && item.data.composition.length > 0 ? (
                <div class="journal-content">
                    <JournalComposition composition={item.data.composition} archiveItems={archiveItems} />
                </div>
            ) : (
                <div class={isJournal ? "journal-content" : "mt-10 prose border border-border p-6"}>
                    <Content />
                </div>
            )
        }
    </article>
</IdLayout>


<style>
    .journal-entry {
        padding-bottom: 3rem;
    }

    .journal-content {
        width: min(100%, 46rem);
        margin: 4rem auto 0;
        padding: clamp(1rem, 3vw, 1.5rem);
        border: 1px solid var(--border);
    }
</style>
