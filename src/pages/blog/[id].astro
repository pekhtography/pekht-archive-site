---
import IdHeader from "@/components/static/IdHeader.astro";
import JournalComposition from "@/components/static/JournalComposition.astro";
import IdLayout from "@/layouts/IdLayout.astro";
import { getCollection, render } from "astro:content";
import { parse } from "date-fns";
import { findMissingJournalSources } from "@/lib/journal-source-validation";

export async function getStaticPaths() {
    const items = await getCollection("blog");
    const archiveItems = await getCollection("archive");
    const journalItems = items.filter((item) => !item.data.draft && item.data.category === "journal");
    const missingSources = findMissingJournalSources(journalItems, archiveItems.map((item) => item.id));

    if (missingSources.length > 0) {
        const details = missingSources
            .map(({ articleId, sourceId }) => `- article="${articleId}" source_id="${sourceId}"`)
            .join("\n");
        throw new Error(`Journal archive source validation failed during build:\n${details}`);
    }
    const legacySamples = items.filter(
        (item) =>
            !item.data.draft &&
            ["markdown-showcase", "aureus-cli-automation"].includes(item.id),
    );
    const pages = [...journalItems, ...legacySamples];

    return pages.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const isJournal = item.data.category === "journal";
const archiveItems = await getCollection("archive");

const allItems = (await getCollection("blog"))
    .filter((item) => !item.data.draft && item.data.category === "journal")
    .sort((a, b) => {
        const dateA = parse(a.data.date, "dd-MM-yyyy", new Date());
        const dateB = parse(b.data.date, "dd-MM-yyyy", new Date());
        return dateA.getTime() - dateB.getTime();
    });

const currentIndex = allItems.findIndex((i) => i.id === item.id);
const prev = currentIndex > 0 ? allItems[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < allItems.length - 1 ? allItems[currentIndex + 1] : null;

const pubDate = parse(item.data.date, "dd-MM-yyyy", new Date());
---

<IdLayout
    type="blog"
    title={item.data.title}
    description={item.data.description}
    image={`/og/blog/${item.id}.png`}
    pubDate={pubDate}
    author={item.data.author}
    tags={item.data.tags}
    prev={prev}
    next={next}
>
    <article
        transition:animate="fade"
        data-journal-article={isJournal ? item.id : undefined}
        class={
            isJournal
                ? item.data.composition.length > 0
                    ? "journal-entry journal-composed-entry"
                    : "journal-entry"
                : ""
        }
    >
        <IdHeader backUrl="/blog" items={item.data} />

        {
            isJournal && item.data.composition.length > 0 ? (
                <div class="journal-content journal-composition-frame">
                    <span
                        class="pointer-events-none absolute left-0 top-0 h-px w-[clamp(4rem,20%,14rem)] bg-border"
                        aria-hidden="true"
                    ></span>
                    <span
                        class="pointer-events-none absolute right-0 top-0 h-px w-[clamp(4rem,20%,14rem)] bg-border"
                        aria-hidden="true"
                    ></span>
                    <JournalComposition
                        composition={item.data.composition}
                        archiveItems={archiveItems}
                        useSavedLayout={item.data.layout_algorithm_version === 1}
                        articleId={item.id}
                    />
                </div>
            ) : (
                <div class={isJournal ? "journal-content" : "mt-10 prose border border-border p-6"}>
                    <Content />
                </div>
            )
        }
    </article>
</IdLayout>

<script>
    const syncJournalContextLinks = () => {
        const article = document.querySelector("[data-journal-article]");
        if (!article) return;

        const articleId = article.getAttribute("data-journal-article");
        if (!articleId) return;

        const currentParams = new URLSearchParams(window.location.search);
        const contextKeys = ["j_facet", "j_sort", "j_page"];
        const hasContext = contextKeys.some((key) => currentParams.has(key));
        const backLink = document.querySelector("[data-journal-back]");

        if (backLink && hasContext) {
            const backUrl = new URL(backLink.href, window.location.href);
            const backParams = new URLSearchParams();
            currentParams.getAll("j_facet").forEach((facet) => backParams.append("j_facet", facet));
            if (currentParams.has("j_sort")) backParams.set("j_sort", currentParams.get("j_sort"));
            if (currentParams.has("j_page")) backParams.set("j_page", currentParams.get("j_page"));
            backParams.set("j_return", articleId);
            backUrl.search = backParams.toString();
            backLink.href = backUrl.toString();
        }

        document.querySelectorAll("[data-journal-nav]").forEach((link) => {
            const navUrl = new URL(link.href, window.location.href);
            contextKeys.forEach((key) => navUrl.searchParams.delete(key));
            navUrl.searchParams.delete("j_return");

            if (hasContext) {
                currentParams.getAll("j_facet").forEach((facet) => navUrl.searchParams.append("j_facet", facet));
                if (currentParams.has("j_sort")) navUrl.searchParams.set("j_sort", currentParams.get("j_sort"));
                if (currentParams.has("j_page")) navUrl.searchParams.set("j_page", currentParams.get("j_page"));
            }

            link.href = navUrl.toString();
        });
    };

    document.addEventListener("astro:page-load", syncJournalContextLinks);
    syncJournalContextLinks();
</script>



<style>
    .journal-entry {
        padding-bottom: 3rem;
    }

    .journal-composition-frame {
        --journal-frame-inset: clamp(1rem, 3vw, 1.5rem);
        position: relative;
        width: 100%;
        margin: 2rem auto 0;
        padding: var(--journal-frame-inset);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .journal-composed-entry {
        padding-bottom: 0;
    }

    .journal-content:not(.journal-composition-frame) {
        width: min(100%, 46rem);
        margin: 4rem auto 0;
        padding: clamp(1rem, 3vw, 1.5rem);
        border: 1px solid var(--border);
    }
</style>
