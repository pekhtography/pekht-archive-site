---
import testGalleries from "@/data/test-galleries.json";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { sitePath } from "@/lib/site-url";

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>(
  "@/assets/portfolio/*/*.{png,jpg,jpeg,webp,gif,avif}",
  { eager: true },
);
const sourceImages = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => module.default);

const photos = await Promise.all(
  sourceImages.slice(0, 6).map(async (src) => (await getImage({ src, width: 1400 })).src),
);

export function getStaticPaths() {
  return testGalleries.map((gallery) => ({ params: { id: gallery.id }, props: { gallery } }));
}

const { gallery } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gallery.title} · Portfolio prototype</title>
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: var(--page-bg, #fff); color: var(--page-fg, #171717); }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      a { color: inherit; }
      header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 1px solid #8885; padding-bottom: 1rem; margin-bottom: 2rem; }
      h1 { font-size: 1.5rem; font-weight: 500; }
      .mosaic { max-width: 480px; aspect-ratio: 2 / 3; position: relative; margin-bottom: 2rem; }
      .images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
      .images button { border: 0; padding: 0; background: transparent; cursor: zoom-in; }
      .images img { display: block; width: 100%; height: 100%; max-height: 70vh; object-fit: contain; background: #8881; }
      dialog { border: 0; padding: 1rem; max-width: min(92vw, 1200px); max-height: 92vh; background: #111; color: white; }
      dialog::backdrop { background: #000d; }
      dialog img { display: block; max-width: 88vw; max-height: 78vh; object-fit: contain; }
      .dialog-controls { display: flex; justify-content: space-between; gap: 1rem; margin-top: .75rem; }
      button.control { padding: .4rem .7rem; cursor: pointer; }
      @media (max-width: 600px) { main { padding: 1.25rem .9rem 3rem; } .images { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main>
      <header><a href={sitePath("/portfolio/test/")}>← All test galleries</a><span>PORTFOLIO · TEST</span></header>
      <h1>{gallery.title}</h1>
      <p>{gallery.facets.join(" · ")}</p>
      <p>Test page for photo viewing only. This does not represent an approved artistic molecule.</p>
      <section class="images" aria-label="Gallery photographs">
        {photos.map((src, index) => (
          <button type="button" class="photo-button" data-index={index} aria-label={`Open photograph ${index + 1}`}>
            <img src={src} alt={`Test photograph ${index + 1}`} loading="lazy" />
          </button>
        ))}
      </section>
      <dialog id="lightbox" aria-label="Photograph viewer">
        <img id="lightbox-image" src={photos[0] ?? ""} alt="Selected photograph" />
        <div class="dialog-controls">
          <button class="control" id="previous" type="button">← Previous</button>
          <span id="counter">1 / {photos.length}</span>
          <button class="control" id="next" type="button">Next →</button>
          <button class="control" id="close" type="button">Close</button>
        </div>
      </dialog>
    </main>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
      const image = document.querySelector<HTMLImageElement>("#lightbox-image");
      const counter = document.querySelector<HTMLElement>("#counter");
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".photo-button"));
      const sources = buttons.map((button) => button.querySelector("img")?.src ?? "");
      let index = 0;
      const show = (nextIndex: number) => {
        if (!sources.length || !image || !counter) return;
        index = (nextIndex + sources.length) % sources.length;
        image.src = sources[index];
        image.alt = `Test photograph ${index + 1}`;
        counter.textContent = `${index + 1} / ${sources.length}`;
      };
      buttons.forEach((button, buttonIndex) => button.addEventListener("click", () => {
        show(buttonIndex);
        dialog?.showModal();
      }));
      document.querySelector("#previous")?.addEventListener("click", () => show(index - 1));
      document.querySelector("#next")?.addEventListener("click", () => show(index + 1));
      document.querySelector("#close")?.addEventListener("click", () => dialog?.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener("keydown", (event) => {
        if (!dialog?.open) return;
        if (event.key === "ArrowLeft") show(index - 1);
        if (event.key === "ArrowRight") show(index + 1);
      });
    </script>
  </body>
</html>
