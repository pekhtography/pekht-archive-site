---
import testGalleries from "@/data/test-galleries.json";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>(
  "@/assets/portfolio/*/*.{png,jpg,jpeg,webp,gif,avif}",
  { eager: true },
);
const sourceImages = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => module.default);

const photos = await Promise.all(
  sourceImages.slice(0, 6).map(async (src) => (await getImage({ src, width: 1000 })).src),
);

const templates: Record<number, { x: number; y: number; w: number; h: number; photo: boolean }[]> = {
  1: [
    { x: 0, y: 0, w: 1, h: 1, photo: true },
    { x: 2, y: 0, w: 1, h: 1, photo: false },
    { x: 2, y: 1, w: 1, h: 1, photo: true },
    { x: 0, y: 2, w: 1.5, h: 1.5, photo: true },
    { x: 1.5, y: 1.5, w: 1.5, h: 1.5, photo: true },
    { x: 0, y: 3.5, w: 1, h: 1, photo: false },
    { x: 1, y: 3.5, w: 1, h: 1, photo: true },
    { x: 2, y: 3.5, w: 1, h: 1, photo: true },
  ],
  2: [
    { x: 1, y: 0, w: 2, h: 2, photo: true },
    { x: 0, y: 0, w: 1, h: 1, photo: false },
    { x: 0, y: 1, w: 1, h: 1, photo: true },
    { x: 0, y: 2, w: 1, h: 1, photo: true },
    { x: 1, y: 2, w: 1, h: 1, photo: true },
    { x: 2, y: 2, w: 1, h: 1, photo: false },
    { x: 0, y: 3, w: 1.5, h: 1.5, photo: true },
    { x: 1.5, y: 3, w: 1.5, h: 1.5, photo: true },
  ],
  3: [
    { x: 0, y: 0, w: 1, h: 1, photo: false },
    { x: 1, y: 0, w: 1, h: 1, photo: true },
    { x: 2, y: 0, w: 1, h: 1, photo: true },
    { x: 0, y: 1, w: 2, h: 2, photo: true },
    { x: 2, y: 1, w: 1, h: 1, photo: true },
    { x: 2, y: 2, w: 1, h: 1, photo: false },
    { x: 0, y: 3, w: 1.5, h: 1.5, photo: true },
    { x: 1.5, y: 3, w: 1.5, h: 1.5, photo: true },
  ],
};
const templateFor = (layout: number) => {
  if (layout <= 3) return templates[layout];
  return templates[layout - 3].map((cell) => ({
    ...cell,
    x: 3 - cell.x - cell.w,
    y: 4.5 - cell.y - cell.h,
  }));
};
const orderedGalleries = testGalleries;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio mosaic prototype</title>
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; font-family: system-ui, sans-serif; background: var(--page-bg, #fff); color: var(--page-fg, #171717); }
      main { max-width: 1200px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 1px solid #8885; padding-bottom: 1rem; margin-bottom: 2rem; }
      header h1 { font-size: 1.2rem; font-weight: 500; margin: 0; }
      header p { font-size: .7rem; letter-spacing: .16em; margin: 0; }
      .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.25rem; }
      .gallery { min-width: 0; }
      .mosaic { position: relative; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; }
      .cell { position: absolute; box-sizing: border-box; padding: 1%; }
      .cell img { display: block; width: 100%; height: 100%; object-fit: cover; }
      .gallery h2 { font-size: 1rem; font-weight: 500; margin: .8rem 0 .5rem; }
      .facets { display: flex; flex-wrap: wrap; gap: .35rem; }
      .facet { font-size: .7rem; border: 1px solid #8886; padding: .2rem .45rem; }
      .notice { color: #777; font-size: .8rem; margin: 1.5rem 0; }
      @media (max-width: 760px) { main { padding: 1.25rem .9rem 3rem; } .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem .8rem; } }
      @media (max-width: 480px) { .gallery-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
    </style>
  </head>
  <body>
    <main>
      <header><h1>PEKHTography</h1><p>PORTFOLIO · TEST</p></header>
      <p class="notice">Prototype only. Placeholder titles and facets; current production portfolio is unchanged.</p>
      <section class="gallery-grid" aria-label="Test gallery mosaics">
        {orderedGalleries.map((gallery) => (
          <article class="gallery">
            <a href={`/pekht-archive-site/portfolio/test/${gallery.id}/`} aria-label={`Open ${gallery.title}`} style="display:block;color:inherit;text-decoration:none">
              <div class="mosaic">
                {templateFor(gallery.layout).map((cell, index) => cell.photo && photos.length > 0 ? (
                  <div class="cell" style={`left:${cell.x / 3 * 100}%;top:${cell.y / 4.5 * 100}%;width:${cell.w / 3 * 100}%;height:${cell.h / 4.5 * 100}%`}>
                    <img src={photos[index % photos.length]} alt="" loading="lazy" />
                  </div>
                ) : null)}
              </div>
              <h2>{gallery.title}</h2>
            </a>
            <div class="facets">{gallery.facets.map((facet) => <span class="facet">{facet}</span>)}</div>
          </article>
        ))}
      </section>
      {photos.length < 6 && <p class="notice">Only {photos.length} portfolio source images were found. Add or select more images before visual acceptance.</p>}
    </main>
  </body>
</html>
