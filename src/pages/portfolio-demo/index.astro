---
import IndexLayout from "@/layouts/IndexLayout.astro";
import IndexHeader from "@/components/static/IndexHeader.astro";
import seed from "@/portfolio-demo-seed.json";

const base = import.meta.env.BASE_URL;
const facets = [...new Set(seed.galleries.flatMap((gallery) => gallery.facets))].sort();
const imageUrl = (path: string) => base + path.slice(1);
---

<IndexLayout title="Portfolio Demo — PEKHTography" description="A demonstration of six curated mini-galleries and a 60-day lifecycle exclusion register." image="/og/default.png">
  <div transition:animate="fade">
    <IndexHeader url="/" heading="Portfolio Demo" description={"Six sample mini-galleries. A 60-day sample exclusion register.\nDemonstration data only — not the final curated Portfolio."} variant="portfolio" />
    <section class="mt-8 border border-amber-500/40 p-4">
      <p class="font-semibold">DEMO DATA — NOT PRODUCTION CURATION</p>
      <p class="mt-2 text-sm text-muted-foreground">The photographs are real archive images. Gallery titles, statements, captions, facets and cooldown events are synthetic examples created to test the future Portfolio experience. This page does not replace the existing /portfolio route.</p>
    </section>
    <section class="mt-8">
      <h2 class="text-xl font-semibold">Filter by facets</h2>
      <div class="mt-3 flex flex-wrap gap-2" id="demo-facets">
        {facets.map((facet) => <button type="button" data-facet={facet} aria-pressed="false" class="border border-border px-3 py-1 text-sm hover:border-foreground">{facet}</button>)}
        <button type="button" data-clear class="border border-border px-3 py-1 text-sm">Clear</button>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">Multiple selected facets use OR logic: a gallery remains visible when it matches at least one selected facet.</p>
    </section>
    <section class="mt-8 grid grid-cols-1 gap-8">
      {seed.galleries.map((gallery, index) => (
        <article data-gallery data-facets={gallery.facets.join("|")} class="border border-border p-4 md:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <p class="text-xs uppercase tracking-widest text-muted-foreground">Mini-gallery {String(index + 1).padStart(2, "0")}</p>
            <p class="text-xs text-muted-foreground">6 photographs · DEMO</p>
          </div>
          <h2 class="mt-2 text-2xl font-semibold">{gallery.title}</h2>
          <p class="mt-2 max-w-3xl text-muted-foreground">{gallery.statement}</p>
          <div class="mt-3 flex flex-wrap gap-2">{gallery.facets.map((facet) => <span class="border border-border px-2 py-1 text-xs">{facet}</span>)}</div>
          <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
            {gallery.photos.map((photo) => (
              <figure class="min-w-0">
                <img src={imageUrl(photo.image)} alt={photo.title} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                <figcaption class="mt-2 text-sm font-medium">{photo.title}</figcaption>
                <p class="mt-1 text-xs text-muted-foreground">{photo.caption}</p>
              </figure>
            ))}
          </div>
        </article>
      ))}
    </section>
    <section class="mt-12 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">60-day exclusion register</h2>
      <p class="mt-2 text-sm text-muted-foreground">12 sample photographs are marked as recently removed from retired demo galleries. Their 60-day cooldown has not expired as of the seed date.</p>
      <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
        {seed.cooldown_demo.map((photo) => (
          <figure class="min-w-0 border border-border p-2">
            <img src={imageUrl(photo.image)} alt={photo.title} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="mt-2 text-xs font-medium">{photo.title}</figcaption>
            <p class="mt-1 text-xs text-muted-foreground">Eligible again: {photo.eligible_again_at.slice(0, 10)}</p>
          </figure>
        ))}
      </div>
    </section>
  </div>
</IndexLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-facet]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery]"));
  const selected = new Set<string>();
  const update = () => {
    for (const card of cards) {
      const cardFacets = (card.dataset.facets ?? "").split("|");
      card.hidden = selected.size > 0 && !cardFacets.some((facet) => selected.has(facet));
    }
    for (const button of buttons) button.setAttribute("aria-pressed", String(selected.has(button.dataset.facet ?? "")));
  };
  for (const button of buttons) button.addEventListener("click", () => {
    const facet = button.dataset.facet ?? "";
    if (selected.has(facet)) selected.delete(facet); else selected.add(facet);
    update();
  });
  document.querySelector<HTMLButtonElement>("[data-clear]")?.addEventListener("click", () => {
    selected.clear();
    update();
  });
</script>
