---
import { sitePath } from "@/lib/site-url";
import Header from "@/components/static/Header.astro";
import Footer from "@/components/static/Footer.astro";
import "@/styles/global.css";
import "@/styles/typography.css";
import Head, { type Props as HeadProps } from "@/components/static/Head.astro";

const headProps = Astro.props as HeadProps;
const section = Astro.url.pathname.startsWith("/archive/")
    ? "Archive"
    : Astro.url.pathname.startsWith("/portfolio")
      ? "Portfolio"
      : Astro.url.pathname.startsWith("/blog")
        ? "Blog"
        : "PEKHTOGRAPHY";
---

<!doctype html>
<html lang="en">
    <Head {...headProps} />
    <body class="mx-auto">
        <Header />
        {/* Content */}
        <main class="max-w-4xl mx-auto" data-pagefind-body>
            <span data-pagefind-meta={"section:" + section} class="sr-only">{section}</span>
            <slot />
        </main>
        <Footer />
        <pagefind-config bundle-path={sitePath("/pagefind/")} base-url={sitePath("/")} />
        <pagefind-modal reset-on-close>
            <pagefind-modal-header>
                <pagefind-input></pagefind-input>
            </pagefind-modal-header>
            <pagefind-modal-body>
                <pagefind-summary></pagefind-summary>
                <pagefind-results>
                    <script type="text/pagefind-template">
                        <li class="pf-result">
                            <div class="pf-result-card">
                                <div class="pf-result-content">
                                    <p class="pf-result-title">
                                        <a class="pf-result-link" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title }}</a>
                                    </p>
                                    {{#if meta.section}}
                                    <p class="text-xs text-muted-foreground mt-0.5">
                                        {{ meta.section }}{{#if meta.date}} · {{ meta.date }}{{/if}}
                                    </p>
                                    {{/if}}
                                    {{#if excerpt}}
                                    <p class="pf-result-excerpt">{{+ excerpt +}}</p>
                                    {{/if}}
                                </div>
                            </div>
                            {{#if sub_results}}
                            <ul class="pf-heading-chips">
                                {{#each sub_results as sub}}
                                <li class="pf-heading-chip">
                                    <a class="pf-heading-link" href="{{ sub.url | safeUrl }}">{{ sub.title }}</a>
                                    {{#if sub.excerpt}}
                                    <p class="pf-heading-excerpt">{{+ sub.excerpt +}}</p>
                                    {{/if}}
                                </li>
                                {{/each}}
                            </ul>
                            {{/if}}
                        </li>
                    </script>
                </pagefind-results>
            </pagefind-modal-body>
            <pagefind-modal-footer>
                <pagefind-keyboard-hints></pagefind-keyboard-hints>
            </pagefind-modal-footer>
        </pagefind-modal>
    </body>
</html>
