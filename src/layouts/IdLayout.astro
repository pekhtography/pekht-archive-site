---
import Header from "@/components/static/Header.astro";
import "@/styles/global.css";
import "@/styles/typography.css";
import "katex/dist/katex.min.css";
import Head, { type Props as HeadProps } from "@/components/static/Head.astro";
import FooterId from "@/components/static/FooterId.astro";

const { type, prev, next, archiveMode, ...headProps } = Astro.props as HeadProps & {
    type: "blog" | "portfolio" | "archive";
    prev: any;
    next: any;
    archiveMode?: "az" | "explore";
};

const section =
    type === "archive"
        ? "Archive"
        : type === "portfolio"
          ? "Portfolio"
          : type === "blog"
            ? "Journal"
            : "PEKHTOGRAPHY";
---

<!doctype html>
<html lang="en">
    <Head {...headProps} type={type === "blog" ? "article" : "website"} />
    <body class="mx-auto">
        <Header />
        {/* Content */}
        <main class={`max-w-4xl mx-auto ${type === "archive" ? "min-h-0" : ""}`} data-pagefind-body>
            <span data-pagefind-meta={`section:${section}`} class="sr-only">{section}</span>
            <slot />
        </main>
        <FooterId type={type} prev={prev} next={next} archiveMode={archiveMode} />
        <pagefind-modal reset-on-close></pagefind-modal>
    </body>
</html>
