---
import { sitePath } from "@/lib/site-url";

type SourceBlock = {
    type: "source";
    source_id: string;
    text: string;
    image_side?: "left" | "right";
};

type BridgeBlock = {
    type: "bridge";
    text: string;
};

type ArchiveItem = {
    id: string;
    data: {
        title: string;
        image: string;
    };
};

const { composition, archiveItems, useSavedLayout = false, articleId = "unknown" } = Astro.props as {
    composition: Array<SourceBlock | BridgeBlock>;
    archiveItems: ArchiveItem[];
    useSavedLayout?: boolean;
    articleId?: string;
};

const archiveMap = new Map(archiveItems.map((item) => [item.id, item]));
---

<div
    class="journal-composition journal-layout-pending"
    data-journal-composition
    data-article-id={articleId}
    data-use-saved-layout={useSavedLayout ? "true" : "false"}
>
    {composition.map((block) =>
        block.type === "source" ? (
            (() => {
                const archive = archiveMap.get(block.source_id);
                if (!archive) return null;

                return (
                    <section
                        class={`journal-source ${useSavedLayout ? (block.image_side === "left" ? "journal-image-left" : block.image_side === "right" ? "journal-image-right" : "") : ""}`}
                        data-journal-source
                        data-image-side={useSavedLayout ? block.image_side : undefined}
                        aria-label={archive.data.title}
                    >
                        <div class="journal-text">
                            <div class="journal-source-text">{block.text}</div>
                        </div>
                        <a
                            class="journal-image"
                            href={sitePath("/archive/explore/" + archive.id)}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={"Open archive post: " + archive.data.title}
                        >
                            <img
                                src={sitePath(archive.data.image)}
                                alt={archive.data.title}
                                loading="lazy"
                            />
                        </a>
                    </section>
                );
            })()
        ) : (
            <div class="journal-bridge" data-journal-bridge>{block.text}</div>
        )
    )}
</div>


<script>
    const ROOT_SELECTOR = "[data-journal-composition]";

    type SourceRecord = {
        section: HTMLElement;
        image: HTMLImageElement;
    };

    type Candidate = {
        sides: number[];
        leftWeight: number;
        rightWeight: number;
        repeatedSides: number;
    };

    function waitForImage(image: HTMLImageElement): Promise<void> {
        if (image.complete) return Promise.resolve();

        return new Promise((resolve) => {
            const finish = () => resolve();
            image.addEventListener("load", finish, { once: true });
            image.addEventListener("error", finish, { once: true });
            // The side-selection algorithm needs real image proportions before
            // choosing sides, so load only the images belonging to this Journal.
            image.loading = "eager";

            if (typeof image.decode === "function") {
                image.decode().then(finish).catch(() => {
                    if (image.complete) finish();
                });
            }
        });
    }

    function imageWeight(image: HTMLImageElement): number {
        if (image.naturalWidth > 0 && image.naturalHeight > 0) {
            return image.naturalHeight / image.naturalWidth;
        }
        return 1;
    }

    function compareCandidates(a: Candidate, b: Candidate): number {
        const balanceA = Math.abs(a.leftWeight - a.rightWeight);
        const balanceB = Math.abs(b.leftWeight - b.rightWeight);
        if (Math.abs(balanceA - balanceB) > 0.001) return balanceA - balanceB;
        if (a.repeatedSides !== b.repeatedSides) return a.repeatedSides - b.repeatedSides;
        return a.sides.join("").localeCompare(b.sides.join(""));
    }

    function chooseSides(records: SourceRecord[]): number[] {
        if (records.length === 0) return [];

        // Preserve the existing maximum-run rule: for the usual 3–6 source
        // blocks, no side receives more than two consecutive images. Larger
        // runs adapt the limit to one third of their source count, rounded up.
        const maxConsecutiveImages = Math.max(2, Math.ceil(records.length / 3));
        let candidates: Candidate[] = [{
            sides: [],
            leftWeight: 0,
            rightWeight: 0,
            repeatedSides: 0,
        }];

        records.forEach((record, index) => {
            const weight = imageWeight(record.image);
            const next: Candidate[] = [];

            for (const candidate of candidates) {
                for (const side of [0, 1]) {
                    let consecutive = 1;
                    for (let i = candidate.sides.length - 1;
                        i >= 0 && candidate.sides[i] === side;
                        i--) consecutive++;
                    if (consecutive > maxConsecutiveImages) continue;

                    const previous = candidate.sides[candidate.sides.length - 1];
                    next.push({
                        sides: [...candidate.sides, side],
                        leftWeight: candidate.leftWeight + (side === 0 ? weight : 0),
                        rightWeight: candidate.rightWeight + (side === 1 ? weight : 0),
                        repeatedSides: candidate.repeatedSides + (index > 0 && previous === side ? 1 : 0),
                    });
                }
            }

            next.sort(compareCandidates);
            candidates = next.slice(0, records.length <= 16 ? next.length : 4096);
        });

        candidates.sort(compareCandidates);
        return candidates[0]?.sides ?? records.map((_, index) => index % 2);
    }

    async function initialize(root: HTMLElement) {
        const nodes = Array.from(root.children);
        const runs: SourceRecord[][] = [];
        let run: SourceRecord[] = [];

        const finishRun = () => {
            if (run.length > 0) runs.push(run);
            run = [];
        };

        for (const node of nodes) {
            if (!(node instanceof HTMLElement) || !node.hasAttribute("data-journal-source")) {
                finishRun();
                continue;
            }

            const image = node.querySelector<HTMLImageElement>(".journal-image img");
            if (!image) {
                finishRun();
                continue;
            }
            run.push({ section: node, image });
        }
        finishRun();

        const allRecords = runs.flat();
        const sourceSections = Array.from(root.querySelectorAll<HTMLElement>("[data-journal-source]"));

        // A fully specified composition uses its saved image_side values as
        // authoritative layout data. This path does not reclassify images,
        // recalculate sides, or split the sequence at bridge blocks.
        const hasCompleteSavedLayout =
            root.dataset.useSavedLayout === "true" &&
            sourceSections.length > 0 &&
            sourceSections.every((section) => section.dataset.imageSide === "left" || section.dataset.imageSide === "right");

        if (root.dataset.useSavedLayout === "true" && !hasCompleteSavedLayout) {
            const missing = sourceSections.filter((section) => section.dataset.imageSide !== "left" && section.dataset.imageSide !== "right").length;
            console.warn(
                `Journal layout: article "${root.dataset.articleId || "unknown"}" marked with ` +
                `layout_algorithm_version: 1 but ${missing} source block(s) have invalid image_side. Falling back to chooseSides().`,
            );
        }

        if (hasCompleteSavedLayout) {
            for (const section of sourceSections) {
                const side = section.dataset.imageSide;
                section.classList.toggle("journal-image-left", side === "left");
                section.classList.toggle("journal-image-right", side === "right");
            }
            return;
        }

        // Articles without a complete saved layout
        // client-side layout behavior, including bridge-separated runs.
        await Promise.all(allRecords.map(({ image }) => waitForImage(image)));

        for (const records of runs) {
            const sides = chooseSides(records);
            records.forEach((record, index) => {
                record.section.classList.toggle("journal-image-left", sides[index] === 0);
                record.section.classList.toggle("journal-image-right", sides[index] === 1);
            });
        }
    }

    const initializedRoots = new WeakSet<HTMLElement>();

    function initializeAll() {
        document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach((root) => {
            if (initializedRoots.has(root)) return;
            initializedRoots.add(root);
            root.classList.add("journal-layout-pending");

            void initialize(root)
                .catch((error) => {
                    console.error("Journal composition layout failed:", error);
                })
                .finally(() => {
                    root.classList.remove("journal-layout-pending");
                    root.classList.add("journal-layout-ready");
                });
        });
    }

    // Astro View Transitions keep this module alive, so initialize new Journal
    // compositions after every client-side navigation as well as on first load.
    document.addEventListener("astro:page-load", initializeAll);
    initializeAll();
</script>

<style is:global>
    .journal-composition {
        display: flex;
        flex-direction: column;
        gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
    }

    /* Keep the uncalculated fallback from flashing before side selection. */
    .journal-composition.journal-layout-pending {
        visibility: hidden;
    }

    .journal-composition.journal-layout-ready {
        visibility: visible;
    }

    /* Each source remains one intact photo + text block. */
    .journal-source {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        column-gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .journal-source-text,
    .journal-bridge {
        font-size: 1.125rem;
        line-height: 1.75rem;
        font-weight: 400;
        white-space: pre-line;
    }

    .journal-text {
        grid-row: 1;
        min-width: 0;
        align-self: center;
    }

    .journal-image {
        grid-row: 1;
        position: relative;
        display: block;
        width: 100%;
        min-width: 0;
        align-self: center;
        overflow: hidden;
    }

    .journal-image img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        transition: opacity 180ms ease;
    }

    .journal-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
            90deg,
            color-mix(in oklab, var(--background) 60%, transparent) 0%,
            transparent 65%
        );
        transition: opacity 180ms ease;
    }

    .journal-image:hover img {
        opacity: 0.88;
    }

    .journal-image:hover::after {
        opacity: 1;
    }

    /* The gradient starts at the outer frame edge and fades toward the text. */
    .journal-source.journal-image-right .journal-image::after {
        background: linear-gradient(
            270deg,
            color-mix(in oklab, var(--background) 60%, transparent) 0%,
            transparent 65%
        );
    }

    .journal-source.journal-image-left .journal-image {
        grid-column: 1;
    }

    .journal-source.journal-image-left .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-source.journal-image-right .journal-image {
        grid-column: 2;
    }

    .journal-source.journal-image-right .journal-text {
        grid-column: 1;
        text-align: right;
    }

    /* A stable no-script fallback; the source pair is never split. */
    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-image {
        grid-column: 1;
    }

    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-bridge {
        width: min(86%, 38rem);
        margin: 0 auto;
        text-align: center;
        padding: 0;
    }

    @media (max-width: 767px) {
        .journal-source {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        }

        .journal-image,
        .journal-text {
            width: 100%;
        }

        .journal-image {
            order: 1;
        }

        .journal-text {
            order: 2;
            text-align: left;
        }

        .journal-source-text {
            width: 100%;
            max-width: none;
        }

        .journal-bridge {
            width: 100%;
        }
    }
</style>
