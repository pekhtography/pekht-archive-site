---
import { resolve } from "node:path";
import sharp from "sharp";
import { chooseJournalSides, type JournalImageClass } from "@/lib/journal-layout";
import { sitePath } from "@/lib/site-url";

type SourceBlock = {
    type: "source";
    source_id: string;
    text: string;
};

type BridgeBlock = {
    type: "bridge";
    text: string;
};

type ArchiveItem = {
    id: string;
    data: {
        title: string;
        image: string;
    };
};

const { composition, archiveItems, useNewLayout = false } = Astro.props as {
    composition: Array<SourceBlock | BridgeBlock>;
    archiveItems: ArchiveItem[];
    useNewLayout?: boolean;
};

const archiveMap = new Map(archiveItems.map((item) => [item.id, item]));
const precomputedSides = new Map<string, "left" | "right">();

if (useNewLayout) {
    // Compute side placement during the Astro build, so the initial HTML
    // already contains the final layout before client navigation.
    let run: Array<{ sourceId: string; imagePath: string }> = [];

    const finishRun = async () => {
        if (run.length === 0) return;
        const records = await Promise.all(run.map(async (record) => {
            try {
                const relativePath = record.imagePath.startsWith("/")
                    ? record.imagePath.slice(1)
                    : record.imagePath;
                const filePath = resolve(process.cwd(), "public", relativePath);
                const metadata = await sharp(filePath).metadata();
                const width = metadata.width ?? 0;
                const height = metadata.height ?? 0;
                const imageClass: JournalImageClass =
                    width > 0 && height > width ? "V" :
                    width > 0 && height === width ? "S" : "H";
                return { ...record, imageClass };
            } catch {
                return { ...record, imageClass: "H" as const };
            }
        }));
        const sides = chooseJournalSides(
            records.map((record) => record.imageClass),
            { forceFirstLeft: true },
        ).sides;
        records.forEach((record, index) => {
            precomputedSides.set(record.sourceId, sides[index] === 0 ? "left" : "right");
        });
        run = [];
    };

    for (const block of composition) {
        if (block.type === "bridge") {
            await finishRun();
            continue;
        }
        const archive = archiveMap.get(block.source_id);
        if (archive) run.push({ sourceId: block.source_id, imagePath: archive.data.image });
    }
    await finishRun();
}
---

<div
    class="journal-composition"
    data-journal-composition
    data-journal-new-layout={useNewLayout ? "true" : undefined}
    data-journal-layout-ready={useNewLayout ? "true" : undefined}
>
    {composition.map((block) =>
        block.type === "source" ? (
            (() => {
                const archive = archiveMap.get(block.source_id);
                if (!archive) return null;

                return (
                    <section
                        class:list={[
                            "journal-source",
                            precomputedSides.get(archive.id) === "left" && "journal-image-left",
                            precomputedSides.get(archive.id) === "right" && "journal-image-right",
                        ]}
                        data-journal-source
                        aria-label={archive.data.title}
                    >
                        <div class="journal-text">
                            <div class="journal-source-text">{block.text}</div>
                        </div>
                        <a
                            class="journal-image"
                            href={sitePath("/archive/explore/" + archive.id)}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={"Open archive post: " + archive.data.title}
                        >
                            <img
                                src={sitePath(archive.data.image)}
                                alt={archive.data.title}
                                loading="lazy"
                            />
                        </a>
                    </section>
                );
            })()
        ) : (
            <div class="journal-bridge" data-journal-bridge>{block.text}</div>
        )
    )}
</div>



<style is:global>
    .journal-composition {
        display: flex;
        flex-direction: column;
        gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
    }

    /* Each source remains one intact photo + text block. */
    .journal-source {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        column-gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .journal-source-text,
    .journal-bridge {
        font-size: 1.125rem;
        line-height: 1.75rem;
        font-weight: 400;
        white-space: pre-line;
    }

    .journal-text {
        grid-row: 1;
        min-width: 0;
        align-self: center;
    }

    .journal-image {
        grid-row: 1;
        position: relative;
        display: block;
        width: 100%;
        min-width: 0;
        align-self: center;
        overflow: hidden;
    }

    .journal-image img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        transition: opacity 180ms ease;
    }

    .journal-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
            90deg,
            color-mix(in oklab, var(--background) 60%, transparent) 0%,
            transparent 65%
        );
        transition: opacity 180ms ease;
    }

    .journal-image:hover img {
        opacity: 0.88;
    }

    .journal-image:hover::after {
        opacity: 1;
    }

    /* The gradient starts at the outer frame edge and fades toward the text. */
    .journal-source.journal-image-right .journal-image::after {
        background: linear-gradient(
            270deg,
            color-mix(in oklab, var(--background) 60%, transparent) 0%,
            transparent 65%
        );
    }

    .journal-source.journal-image-left .journal-image {
        grid-column: 1;
    }

    .journal-source.journal-image-left .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-source.journal-image-right .journal-image {
        grid-column: 2;
    }

    .journal-source.journal-image-right .journal-text {
        grid-column: 1;
        text-align: right;
    }

    /* A stable no-script fallback; the source pair is never split. */
    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-image {
        grid-column: 1;
    }

    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-bridge {
        width: min(86%, 38rem);
        margin: 0 auto;
        padding: 0;
    }

    @media (max-width: 767px) {
        .journal-source {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        }

        .journal-image,
        .journal-text {
            width: 100%;
        }

        .journal-image {
            order: 1;
        }

        .journal-text {
            order: 2;
            text-align: left;
        }

        .journal-source-text {
            width: 100%;
            max-width: none;
        }

        .journal-bridge {
            width: 100%;
        }
    }
</style>
