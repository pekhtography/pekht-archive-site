---
import { sitePath } from "@/lib/site-url";

type SourceBlock = {
    type: "source";
    source_id: string;
    text: string;
    // Kept in the schema for compatibility with published Journal entries.
    image_side: "left" | "right";
    image_size: "small" | "medium" | "large";
    text_offset: "up" | "center" | "down";
};

type BridgeBlock = {
    type: "bridge";
    text: string;
};

type ArchiveItem = {
    id: string;
    data: {
        title: string;
        image: string;
    };
};

const { composition, archiveItems } = Astro.props as {
    composition: Array<SourceBlock | BridgeBlock>;
    archiveItems: ArchiveItem[];
};

const archiveMap = new Map(archiveItems.map((item) => [item.id, item]));
---

<div class="journal-composition" data-journal-composition>
    {composition.map((block) =>
        block.type === "source" ? (
            (() => {
                const archive = archiveMap.get(block.source_id);
                if (!archive) return null;

                return (
                    <section class="journal-source" data-journal-source aria-label={archive.data.title}>
                        <div class="journal-text">
                            <div class="journal-source-text">{block.text}</div>
                        </div>
                        <a
                            class="journal-image"
                            href={sitePath("/archive/explore/" + archive.id)}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={"Open archive post: " + archive.data.title}
                        >
                            <img
                                src={sitePath(archive.data.image)}
                                alt={archive.data.title}
                                loading="lazy"
                            />
                        </a>
                    </section>
                );
            })()
        ) : (
            <div class="journal-bridge" data-journal-bridge>{block.text}</div>
        )
    )}
</div>


<script>
    const ROOT_SELECTOR = "[data-journal-composition]";

    type SourceRecord = {
        section: HTMLElement;
        image: HTMLImageElement;
    };

    type Candidate = {
        sides: number[];
        leftWeight: number;
        rightWeight: number;
        repeatedSides: number;
    };

    function waitForImage(image: HTMLImageElement): Promise<void> {
        if (image.complete) return Promise.resolve();

        return new Promise((resolve) => {
            const finish = () => resolve();
            image.addEventListener("load", finish, { once: true });
            image.addEventListener("error", finish, { once: true });
            // The side-selection algorithm needs real image proportions before
            // choosing sides, so load only the images belonging to this Journal.
            image.loading = "eager";

            if (typeof image.decode === "function") {
                image.decode().then(finish).catch(() => {
                    if (image.complete) finish();
                });
            }
        });
    }

    function imageWeight(image: HTMLImageElement): number {
        if (image.naturalWidth > 0 && image.naturalHeight > 0) {
            return image.naturalHeight / image.naturalWidth;
        }
        return 1;
    }

    function compareCandidates(a: Candidate, b: Candidate): number {
        const balanceA = Math.abs(a.leftWeight - a.rightWeight);
        const balanceB = Math.abs(b.leftWeight - b.rightWeight);
        if (Math.abs(balanceA - balanceB) > 0.001) return balanceA - balanceB;
        if (a.repeatedSides !== b.repeatedSides) return a.repeatedSides - b.repeatedSides;
        return a.sides.join("").localeCompare(b.sides.join(""));
    }

    function chooseSides(records: SourceRecord[]): number[] {
        if (records.length === 0) return [];

        // Preserve the existing maximum-run rule: for the usual 3–6 source
        // blocks, no side receives more than two consecutive images. Larger
        // runs adapt the limit to one third of their source count, rounded up.
        const maxConsecutiveImages = Math.max(2, Math.ceil(records.length / 3));
        let candidates: Candidate[] = [{
            sides: [],
            leftWeight: 0,
            rightWeight: 0,
            repeatedSides: 0,
        }];

        records.forEach((record, index) => {
            const weight = imageWeight(record.image);
            const next: Candidate[] = [];

            for (const candidate of candidates) {
                for (const side of [0, 1]) {
                    let consecutive = 1;
                    for (let i = candidate.sides.length - 1;
                        i >= 0 && candidate.sides[i] === side;
                        i--) consecutive++;
                    if (consecutive > maxConsecutiveImages) continue;

                    const previous = candidate.sides[candidate.sides.length - 1];
                    next.push({
                        sides: [...candidate.sides, side],
                        leftWeight: candidate.leftWeight + (side === 0 ? weight : 0),
                        rightWeight: candidate.rightWeight + (side === 1 ? weight : 0),
                        repeatedSides: candidate.repeatedSides + (index > 0 && previous === side ? 1 : 0),
                    });
                }
            }

            next.sort(compareCandidates);
            candidates = next.slice(0, records.length <= 16 ? next.length : 4096);
        });

        candidates.sort(compareCandidates);
        return candidates[0]?.sides ?? records.map((_, index) => index % 2);
    }

    async function initialize(root: HTMLElement) {
        const nodes = Array.from(root.children);
        const runs: SourceRecord[][] = [];
        let run: SourceRecord[] = [];

        const finishRun = () => {
            if (run.length > 0) runs.push(run);
            run = [];
        };

        for (const node of nodes) {
            if (!(node instanceof HTMLElement) || !node.hasAttribute("data-journal-source")) {
                finishRun();
                continue;
            }

            const image = node.querySelector<HTMLImageElement>(".journal-image img");
            if (!image) {
                finishRun();
                continue;
            }
            run.push({ section: node, image });
        }
        finishRun();

        // Bridges split the composition into independent runs, as before.
        await Promise.all(runs.flat().map(({ image }) => waitForImage(image)));

        for (const records of runs) {
            const sides = chooseSides(records);
            records.forEach((record, index) => {
                record.section.classList.toggle("journal-image-left", sides[index] === 0);
                record.section.classList.toggle("journal-image-right", sides[index] === 1);
            });
        }
    }

    document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach((root) => {
        void initialize(root);
    });
</script>

<style is:global>
    .journal-composition {
        display: flex;
        flex-direction: column;
        gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
    }

    /* Each source remains one intact photo + text block. */
    .journal-source {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
        column-gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .journal-source-text,
    .journal-bridge {
        font-size: 1.125rem;
        line-height: 1.75rem;
        font-weight: 400;
        white-space: pre-line;
    }

    .journal-text {
        grid-row: 1;
        min-width: 0;
        align-self: center;
    }

    .journal-image {
        grid-row: 1;
        position: relative;
        display: block;
        width: 100%;
        min-width: 0;
        align-self: center;
        overflow: hidden;
    }

    .journal-image img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        transition: opacity 180ms ease;
    }

    .journal-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(
            90deg,
            color-mix(in oklab, var(--background) 78%, transparent) 0%,
            transparent 45%,
            transparent 55%,
            color-mix(in oklab, var(--background) 78%, transparent) 100%
        );
        transition: opacity 180ms ease;
    }

    .journal-image:hover img {
        opacity: 0.76;
    }

    .journal-image:hover::after {
        opacity: 1;
    }

    .journal-source.journal-image-left .journal-image {
        grid-column: 1;
    }

    .journal-source.journal-image-left .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-source.journal-image-right .journal-image {
        grid-column: 2;
    }

    .journal-source.journal-image-right .journal-text {
        grid-column: 1;
        text-align: right;
    }

    /* A stable no-script fallback; the source pair is never split. */
    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-image {
        grid-column: 1;
    }

    .journal-source:not(.journal-image-left):not(.journal-image-right) .journal-text {
        grid-column: 2;
        text-align: left;
    }

    .journal-bridge {
        width: min(86%, 38rem);
        margin: 0 auto;
        padding: 0;
    }

    @media (max-width: 767px) {
        .journal-source {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: var(--journal-frame-inset, clamp(1rem, 3vw, 1.5rem));
        }

        .journal-image,
        .journal-text {
            width: 100%;
        }

        .journal-image {
            order: 1;
        }

        .journal-text {
            order: 2;
            text-align: left;
        }

        .journal-source-text {
            width: 100%;
            max-width: none;
        }

        .journal-bridge {
            width: 100%;
        }
    }
</style>
