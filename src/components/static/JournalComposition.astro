---
import { sitePath } from "@/lib/site-url";

type SourceBlock = {
    type: "source";
    source_id: string;
    text: string;
    // Kept in the schema for compatibility with published Journal entries.
    image_side: "left" | "right";
    image_size: "small" | "medium" | "large";
    text_offset: "up" | "center" | "down";
};

type BridgeBlock = {
    type: "bridge";
    text: string;
};

type ArchiveItem = {
    id: string;
    data: {
        title: string;
        image: string;
    };
};

const { composition, archiveItems } = Astro.props as {
    composition: Array<SourceBlock | BridgeBlock>;
    archiveItems: ArchiveItem[];
};

const archiveMap = new Map(archiveItems.map((item) => [item.id, item]));
---

<div class="journal-composition" data-journal-composition>
    {composition.map((block) =>
        block.type === "source" ? (
            (() => {
                const archive = archiveMap.get(block.source_id);
                if (!archive) return null;

                return (
                    <section class="journal-source" data-journal-source aria-label={archive.data.title}>
                        <div class="journal-text">
                            <div class="journal-source-text">{block.text}</div>
                        </div>
                        <a
                            class="journal-image"
                            href={sitePath("/archive/explore/" + archive.id)}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={"Open archive post: " + archive.data.title}
                        >
                            <img
                                src={sitePath(archive.data.image)}
                                alt={archive.data.title}
                                loading="lazy"
                            />
                        </a>
                    </section>
                );
            })()
        ) : (
            <div class="journal-bridge" data-journal-bridge>{block.text}</div>
        )
    )}
</div>

<script>
    const ROOT_SELECTOR = "[data-journal-composition]";
    const DESKTOP_QUERY = "(min-width: 768px)";
    const COLUMN_GAP = "clamp(1rem, 2vw, 1.5rem)";

    type SourceRecord = {
        section: HTMLElement;
        text: HTMLElement;
        image: HTMLAnchorElement;
    };

    function getSourceRecord(section: HTMLElement): SourceRecord | null {
        const text = section.querySelector<HTMLElement>(".journal-text");
        const image = section.querySelector<HTMLAnchorElement>(".journal-image");
        return text && image ? { section, text, image } : null;
    }

    function waitForImage(image: HTMLImageElement): Promise<void> {
        if (image.complete && image.naturalWidth > 0) return Promise.resolve();

        return new Promise((resolve) => {
            const finish = () => resolve();
            image.addEventListener("load", finish, { once: true });
            image.addEventListener("error", finish, { once: true });
            image.loading = "eager";

            if (typeof image.decode === "function") {
                image.decode().then(finish).catch(() => {
                    // A failed decode may still be followed by load/error.
                    if (image.complete) finish();
                });
            }
        });
    }

    function measureTextHeight(text: HTMLElement, width: number): number {
        const measure = document.createElement("div");
        measure.className = "journal-source-text journal-measure-text";
        measure.style.width = width + "px";
        measure.textContent = text.querySelector(".journal-source-text")?.textContent ?? "";
        document.body.append(measure);
        const height = measure.getBoundingClientRect().height;
        measure.remove();
        return height;
    }

    function imageHeight(image: HTMLImageElement, width: number): number {
        if (image.naturalWidth > 0 && image.naturalHeight > 0) {
            return width * image.naturalHeight / image.naturalWidth;
        }
        return width * 0.75;
    }

    function makeColumn(): HTMLDivElement {
        const column = document.createElement("div");
        column.className = "journal-column";
        return column;
    }

    function makeLayout(): { layout: HTMLDivElement; left: HTMLDivElement; right: HTMLDivElement } {
        const layout = document.createElement("div");
        layout.className = "journal-layout";
        const left = makeColumn();
        const right = makeColumn();
        layout.append(left, right);
        return { layout, left, right };
    }

    function restoreOriginal(root: HTMLElement, originalNodes: Element[], records: SourceRecord[]) {
        for (const record of records) {
            record.section.className = "journal-source";
            record.text.className = "journal-text";
            record.image.className = "journal-image";
            record.section.append(record.text, record.image);
        }
        root.replaceChildren(...originalNodes);
        root.classList.remove("journal-is-laid-out");
    }

    async function layoutComposition(root: HTMLElement) {
        const originalNodes = Array.from(root.children);
        const records = originalNodes
            .filter((node): node is HTMLElement => node instanceof HTMLElement && node.hasAttribute("data-journal-source"))
            .map(getSourceRecord)
            .filter((record): record is SourceRecord => record !== null);

        if (records.length === 0) return;

        await Promise.all(records.map((record) => waitForImage(record.image.querySelector("img")!)));
        if (!window.matchMedia(DESKTOP_QUERY).matches) return;

        const recordBySection = new Map(records.map((record) => [record.section, record]));
        const fragment = document.createDocumentFragment();
        let pendingRun: SourceRecord[] = [];

        const flushRun = () => {
            if (pendingRun.length === 0) return;

            const { layout, left, right } = makeLayout();
            const rootWidth = root.getBoundingClientRect().width;
            const gap = Math.min(14, Math.max(10, window.innerWidth * 0.012));
            const columnWidth = Math.max(1, (rootWidth - gap) / 2);
            layout.style.setProperty("--journal-column-gap", "clamp(0.75rem, 1.2vw, 0.9rem)");

            const items = pendingRun.map((record) => {
                const img = record.image.querySelector("img")!;
                return {
                    record,
                    imageHeight: imageHeight(img, columnWidth),
                    textHeight: measureTextHeight(record.text, columnWidth),
                };
            });

            // Choose the orientation for the entire run, not one pair at a time.
            // 0 = image left / text right; 1 = text left / image right.
            // Each source contributes exactly one item to each column, so both
            // columns retain the original source order A -> B -> C -> ...
            type Candidate = {
                orientations: number[];
                leftHeight: number;
                rightHeight: number;
                score: number;
            };
            let candidates: Candidate[] = [{
                orientations: [],
                leftHeight: 0,
                rightHeight: 0,
                score: 0,
            }];

            for (let index = 0; index < items.length; index++) {
                const item = items[index];
                const next: Candidate[] = [];

                for (const candidate of candidates) {
                    for (const orientation of [0, 1]) {
                        const leftItemHeight = orientation === 0 ? item.imageHeight : item.textHeight;
                        const rightItemHeight = orientation === 0 ? item.textHeight : item.imageHeight;
                        const leftHeight = candidate.leftHeight + leftItemHeight + (index > 0 ? gap : 0);
                        const rightHeight = candidate.rightHeight + rightItemHeight + (index > 0 ? gap : 0);
                        const previous = candidate.orientations[candidate.orientations.length - 1];
                        const repeatedSidePenalty = previous === orientation ? columnWidth * 0.28 : 0;
                        next.push({
                            orientations: [...candidate.orientations, orientation],
                            leftHeight,
                            rightHeight,
                            // Penalize imbalance at every prefix, not just at the end.
                            // A modest repeat penalty prevents a trivial all-photos-on-one-
                            // side layout when several orientations have similar total height.
                            score: candidate.score
                                + Math.abs(leftHeight - rightHeight)
                                + repeatedSidePenalty,
                        });
                    }
                }

                // Five-source compositions evaluate all 2^5 layouts. For unusually
                // long runs, keep a diverse beam so the search remains bounded.
                next.sort((a, b) => a.score - b.score);
                const beamWidth = items.length <= 12 ? next.length : 512;
                candidates = next.slice(0, beamWidth);
            }

            candidates.sort((a, b) => {
                const scoreA = a.score + Math.abs(a.leftHeight - a.rightHeight) * 1.5;
                const scoreB = b.score + Math.abs(b.leftHeight - b.rightHeight) * 1.5;
                return scoreA - scoreB;
            });
            const best = candidates[0];

            items.forEach(({ record }, index) => {
                const imageGoesLeft = best.orientations[index] === 0;
                record.section.remove();
                record.image.className = "journal-image";
                record.text.className = "journal-text-block " + (imageGoesLeft ? "journal-text-align-right" : "journal-text-align-left");

                if (imageGoesLeft) {
                    left.append(record.image);
                    right.append(record.text);
                } else {
                    right.append(record.image);
                    left.append(record.text);
                }
            });

            fragment.append(layout);
            pendingRun = [];
        };

        for (const node of originalNodes) {
            if (node instanceof HTMLElement && recordBySection.has(node)) {
                pendingRun.push(recordBySection.get(node)!);
            } else {
                flushRun();
                fragment.append(node);
            }
        }
        flushRun();

        root.replaceChildren(fragment);
        root.classList.add("journal-is-laid-out");
    }

    function initialize(root: HTMLElement) {
        const originalNodes = Array.from(root.children);
        const records = originalNodes
            .filter((node): node is HTMLElement => node instanceof HTMLElement && node.hasAttribute("data-journal-source"))
            .map(getSourceRecord)
            .filter((record): record is SourceRecord => record !== null);
        let isDesktopLayout = false;
        let pending = false;

        const update = async () => {
            if (pending) return;
            pending = true;
            try {
                const wantsDesktop = window.matchMedia(DESKTOP_QUERY).matches;
                if (wantsDesktop && !isDesktopLayout) {
                    await layoutComposition(root);
                    isDesktopLayout = root.classList.contains("journal-is-laid-out");
                } else if (!wantsDesktop && isDesktopLayout) {
                    restoreOriginal(root, originalNodes, records);
                    isDesktopLayout = false;
                }
            } finally {
                pending = false;
            }
        };

        void update();
        window.addEventListener("resize", () => {
            const wantsDesktop = window.matchMedia(DESKTOP_QUERY).matches;
            if (wantsDesktop !== isDesktopLayout) void update();
        });
    }

    document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach(initialize);
</script>

<style>
    .journal-composition {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    /* No-JavaScript fallback and the pre-layout state. */
    .journal-source {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
        column-gap: clamp(1rem, 2vw, 1.5rem);
        padding: clamp(0.75rem, 1.5vw, 1rem) 0;
    }

    .journal-source-text {
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        line-height: 1.85;
        white-space: pre-line;
    }

    .journal-text {
        grid-column: 2;
        grid-row: 1;
    }

    .journal-image {
        grid-column: 1;
        grid-row: 1;
        display: block;
        width: 100%;
        align-self: start;
        overflow: hidden;
    }

    .journal-image img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
        transition: opacity 180ms ease;
    }

    .journal-image:hover img {
        opacity: 0.94;
    }

    .journal-bridge {
        width: min(86%, 38rem);
        margin: 0 auto;
        padding: clamp(0.75rem, 2vw, 1.5rem) 0;
        font-size: clamp(1rem, 1.25vw, 1.1rem);
        line-height: 1.85;
        white-space: pre-line;
    }

    .journal-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        column-gap: var(--journal-column-gap, clamp(1rem, 2vw, 1.5rem));
        align-items: start;
        padding: 0;
    }

    .journal-column {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 2vw, 1.5rem);
        min-width: 0;
    }

    .journal-layout .journal-image,
    .journal-layout .journal-text-block {
        width: 100%;
        min-width: 0;
        margin: 0;
    }

    .journal-text-block {
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        line-height: 1.85;
        white-space: pre-line;
    }

    .journal-text-align-left {
        text-align: left;
    }

    .journal-text-align-right {
        text-align: right;
    }

    .journal-measure-text {
        position: absolute;
        top: 0;
        left: -100000px;
        visibility: hidden;
        box-sizing: border-box;
        font-size: clamp(1rem, 1.35vw, 1.15rem);
        line-height: 1.85;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    @media (max-width: 767px) {
        .journal-source {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            padding: 1.25rem 0;
        }

        .journal-image {
            order: 1;
            width: 100%;
        }

        .journal-text {
            order: 2;
            width: 100%;
        }

        .journal-source-text {
            width: 100%;
            max-width: none;
        }

        .journal-bridge {
            width: 100%;
            padding: 1rem 0;
        }
    }
</style>
