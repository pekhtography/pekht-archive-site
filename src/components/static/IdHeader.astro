---
import { RiCalendar2Line } from "@remixicon/react";
import BackButton from "../static/BackButton.astro";
import ShareButton from "../client/ShareButton.tsx";
import { parse, format } from "date-fns";

const { backUrl, items } = Astro.props;
const isJournal = items.category === "journal";

const parsedDate = parse(items.date, "dd-MM-yyyy", new Date());
const formattedDate = format(parsedDate, "MMM dd, yyyy");
const titleWords = String(items.title).trim().split(/\s+/);
const titleLead = titleWords.slice(0, 3).join(" ");
const titleContinuation = titleWords.slice(3).join(" ");
---

<div class:list={[
    "mt-10",
    "border border-border p-6 bg-background"
]}>
    <BackButton url={backUrl} />

    <header class:list={["mt-3 select-none", isJournal ? "journal-header-inner" : ""]}>
        {
            isJournal ? (
                <>
                    <h1 class="pt-3 text-5xl font-semibold opacity-90 select-none">{titleLead}</h1>
                    <p class="mt-3 max-w-3xl text-lg text-muted-foreground whitespace-pre-line">{titleContinuation}</p>
                </>
            ) : (
                <h1 class="text-5xl font-semibold opacity-90">{items.title}</h1>
            )
        }

        {
            isJournal ? (
                <div class="flex flex-wrap items-center gap-3 mt-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-3 mr-3">
                        <RiCalendar2Line className="size-4" />
                        <span>{formattedDate}</span>
                    </div>

                    {
                        items.facets && items.facets.length > 0 && (
                            <div class="flex flex-wrap gap-2">
                                {items.facets.map((facet: string) => (
                                    <span class="text-xs px-3 py-1 bg-muted text-muted-foreground border border-border rounded">{facet}</span>
                                ))}
                            </div>
                        )
                    }

                    <ShareButton client:load />
                </div>
            ) : (
                <>
                    <p class="text-base text-muted-foreground mt-4 max-w-2xl">{items.description}</p>

                    <div class="flex items-center gap-3 mt-3 text-sm text-muted-foreground">
                        <div class="flex items-center gap-3 mr-3">
                            <RiCalendar2Line className="size-4" />
                            <span>{formattedDate}</span>
                        </div>
                        <span class="text-xs px-2 py-0.5 border border-muted-foreground/30 text-muted-foreground rounded uppercase mr-1">
                            {items.category}
                        </span>
                        <ShareButton client:load />
                    </div>

                    {
                        items.tags && items.tags.length > 0 && (
                            <div class="flex gap-2 mt-4 flex-wrap">
                                {items.tags.map((tag: string) => (
                                    <span class="text-xs px-3 py-1 bg-muted text-muted-foreground rounded">{tag}</span>
                                ))}
                            </div>
                        )
                    }
                </>
            )
        }
    </header>
</div>
