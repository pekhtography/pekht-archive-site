---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb";
import site_config from "@/site-config.json";
import { sitePath } from "@/lib/site-url";

const { pathname } = Astro.props;
const isCurrent = (href: string) => pathname === href;
const itemPath = (item: string) =>
  item === "archive"
    ? "/archive/explore"
    : item === "journal"
      ? "/blog"
      : `/${item}`;
---

{
  site_config.bNavigation && (
    <>
      <Breadcrumb className="select-none">
        <BreadcrumbList>
          {/* Home */}
          <BreadcrumbItem>
            {isCurrent("/") ? (
              <BreadcrumbPage>{site_config.homeLabel}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href={sitePath("/")}>{site_config.homeLabel}</BreadcrumbLink>
            )}
          </BreadcrumbItem>

          {site_config.navigationItems &&
            site_config.navigationItems.map((item) => {
              const href = sitePath(itemPath(item));

              return (
                <>
                  <BreadcrumbSeparator>•</BreadcrumbSeparator>
                  <BreadcrumbItem>
                    {pathname.startsWith(href) ? (
                      <BreadcrumbPage>{item}</BreadcrumbPage>
                    ) : (
                      <BreadcrumbLink href={href}>{item}</BreadcrumbLink>
                    )}
                  </BreadcrumbItem>
                </>
              );
            })}
        </BreadcrumbList>
      </Breadcrumb>
    </>
  )
}
