---
import BackButton from "./BackButton.astro";
import { sitePath } from "@/lib/site-url";

const { url, heading, description, variant, archiveMode } = Astro.props;
---

<div class="border border-border p-6 mt-10 bg-background">
    <BackButton url={url} />
    <h1 class="pt-3 text-5xl font-semibold opacity-90 select-none">{heading}</h1>

    {
        description && (
            <p class={variant === "archive" ? "mt-3 max-w-3xl text-lg text-muted-foreground whitespace-pre-line" : "mt-4 max-w-prose text-base leading-relaxed text-secondary-foreground/80"}>
                {description}
            </p>
        )
    }

    {
        variant === "archive" && archiveMode && (
            <div
                id="archive-mode-switch"
                class="mt-6 grid grid-cols-[minmax(0,1fr)_6rem_6rem] items-center gap-x-2 sm:gap-x-4"
                aria-label="Archive mode"
                data-active-mode={archiveMode}
            >
                <div class="relative h-9 min-w-0 overflow-hidden text-right text-sm">
                    <span
                        data-mode-description="explore"
                        class:list={[
                            "absolute inset-0 flex w-full items-center justify-end text-right transition-all duration-200",
                            archiveMode === "explore"
                                ? "translate-x-0 opacity-100 text-foreground"
                                : "translate-x-2 opacity-0 text-muted-foreground/50",
                        ]}
                    >
                        From the everyday to the once noticed
                    </span>
                    <span
                        data-mode-description="az"
                        class:list={[
                            "absolute inset-0 flex w-full items-center justify-end text-right transition-all duration-200",
                            archiveMode === "az"
                                ? "translate-x-0 opacity-100 text-foreground"
                                : "translate-x-2 opacity-0 text-muted-foreground/50",
                        ]}
                    >
                        A passage through a range of things
                    </span>
                </div>

                <a
                    data-mode-link="explore"
                    href={sitePath("/archive/explore")}
                    aria-current={archiveMode === "explore" ? "page" : undefined}
                    class:list={[
                        "archive-mode-link inline-flex h-9 w-24 items-center justify-center justify-self-end rounded-[min(var(--radius-md),10px)] border px-3 text-sm transition-all duration-200",
                        archiveMode === "explore"
                            ? "border-transparent bg-secondary text-secondary-foreground"
                            : "border-border bg-background text-muted-foreground hover:bg-secondary/50 hover:text-foreground",
                    ]}
                >
                    <span
                        data-mode-label="explore"
                        class:list={[
                            "transition-all duration-200",
                            archiveMode === "explore"
                                ? "translate-x-0 opacity-100"
                                : "translate-x-0 opacity-100 text-muted-foreground",
                        ]}
                    >
                        Explore
                    </span>
                </a>

                <a
                    data-mode-link="az"
                    href={sitePath("/archive")}
                    aria-current={archiveMode === "az" ? "page" : undefined}
                    class:list={[
                        "archive-mode-link inline-flex h-9 w-24 items-center justify-center justify-self-end rounded-[min(var(--radius-md),10px)] border px-3 text-sm transition-all duration-200",
                        archiveMode === "az"
                            ? "border-transparent bg-secondary text-secondary-foreground"
                            : "border-border bg-background text-muted-foreground hover:bg-secondary/50 hover:text-foreground",
                    ]}
                >
                    <span
                        data-mode-label="az"
                        class:list={[
                            "transition-all duration-200",
                            archiveMode === "az"
                                ? "translate-x-0 opacity-100"
                                : "translate-x-0 opacity-100 text-muted-foreground",
                        ]}
                    >
                        A–Z
                    </span>
                </a>
            </div>
        )
    }
</div>

{
    variant === "archive" && archiveMode && (
        <script>
            const initArchiveModeSwitch = () => {
                const switcher = document.querySelector("#archive-mode-switch");
                if (!(switcher instanceof HTMLElement)) return;

                const activeMode = switcher.dataset.activeMode;
                if (!activeMode) return;

                const links = Array.from(
                    switcher.querySelectorAll("[data-mode-link]"),
                ).filter((element): element is HTMLAnchorElement =>
                    element instanceof HTMLAnchorElement,
                );

                const descriptions = Array.from(
                    switcher.querySelectorAll("[data-mode-description]"),
                ).filter((element): element is HTMLElement =>
                    element instanceof HTMLElement,
                );

                const labels = Array.from(
                    switcher.querySelectorAll("[data-mode-label]"),
                ).filter((element): element is HTMLElement =>
                    element instanceof HTMLElement,
                );

                if (links.length !== 2 || descriptions.length !== 2 || labels.length !== 2) return;

                const modeOf = (element: Element) =>
                    element.getAttribute("data-mode-link") ??
                    element.getAttribute("data-mode-description") ??
                    element.getAttribute("data-mode-label");

                const show = (
                    element: HTMLElement,
                    visible: boolean,
                    enterFromRight = true,
                ) => {
                    element.classList.remove("translate-x-0", "translate-x-2", "-translate-x-2");
                    element.classList.add(
                        visible ? "translate-x-0" : enterFromRight ? "translate-x-2" : "-translate-x-2",
                    );
                    element.classList.toggle("opacity-100", visible);
                    element.classList.toggle("opacity-0", !visible);
                };

                const stable = () => {
                    links.forEach((link) => {
                        const isActive = modeOf(link) === activeMode;

                        link.classList.toggle("bg-secondary", isActive);
                        link.classList.toggle("text-secondary-foreground", isActive);
                        link.classList.toggle("border-transparent", isActive);

                        link.classList.toggle("bg-background", !isActive);
                        link.classList.toggle("text-muted-foreground", !isActive);
                        link.classList.toggle("border-border", !isActive);
                        link.classList.remove("bg-secondary/50", "text-foreground", "text-background");
                    });

                    descriptions.forEach((description) => {
                        const isActive = modeOf(description) === activeMode;
                        description.classList.remove("text-background", "text-muted-foreground/50");
                        description.classList.add(
                            isActive ? "text-foreground" : "text-muted-foreground/50",
                        );
                        show(description, isActive);
                    });

                    labels.forEach((label) => {
                        const isActive = modeOf(label) === activeMode;
                        label.classList.remove("text-background");
                        if (isActive) label.classList.add("text-secondary-foreground");
                        show(label, true);
                    });
                };

                const preview = (mode: string) => {
                    if (mode === activeMode) return;

                    links.forEach((link) => {
                        const isActive = modeOf(link) === activeMode;
                        const isHovered = modeOf(link) === mode;

                        if (isActive) {
                            link.classList.remove("text-secondary-foreground");
                            link.classList.add("text-muted-foreground");
                        }

                        if (isHovered) {
                            link.classList.remove("bg-background", "border-border", "text-muted-foreground");
                            link.classList.add("bg-secondary/50", "border-border", "text-foreground");
                        }
                    });

                    descriptions.forEach((description) => {
                        const isPreview = modeOf(description) === mode;
                        const isActive = modeOf(description) === activeMode;

                        if (isActive) {
                            description.classList.remove("text-foreground", "text-muted-foreground/50");
                            description.classList.add("text-background");
                            show(description, false, false);
                        } else if (isPreview) {
                            description.classList.remove("text-muted-foreground/50", "text-background");
                            description.classList.add("text-foreground");
                            show(description, true, true);
                        }
                    });

                    labels.forEach((label) => {
                        const isActive = modeOf(label) === activeMode;

                        if (isActive) {
                            label.classList.remove("text-secondary-foreground");
                            label.classList.add("text-background");
                            show(label, true);
                        }
                    });
                };

                links.forEach((link) => {
                    link.addEventListener("pointerenter", (event) => {
                        if (event.pointerType === "mouse") {
                            preview(modeOf(link) ?? "");
                        }
                    });
                });

                switcher.addEventListener("pointerleave", (event) => {
                    if (event.pointerType === "mouse") {
                        stable();
                    }
                });

                stable();

                requestAnimationFrame(() => {
                    const activeLabel = labels.find(
                        (label) => modeOf(label) === activeMode,
                    );
                    const activeLink = links.find(
                        (link) => modeOf(link) === activeMode,
                    );

                    if (activeLabel && activeLink) {
                        activeLabel.classList.remove("translate-x-0", "opacity-100", "text-background");
                        activeLabel.classList.add("translate-x-2", "opacity-0");

                        activeLink.classList.remove(
                            "bg-secondary",
                            "border-transparent",
                        );
                        activeLink.classList.add(
                            "bg-secondary/70",
                            "border-border",
                            "translate-x-1",
                        );

                        requestAnimationFrame(() => {
                            activeLabel.classList.remove("translate-x-2", "opacity-0");
                            activeLabel.classList.add("translate-x-0", "opacity-100");

                            activeLink.classList.remove(
                                "bg-secondary/70",
                                "border-border",
                                "translate-x-1",
                            );
                            activeLink.classList.add(
                                "bg-secondary",
                                "border-transparent",
                                "translate-x-0",
                            );
                        });
                    }
                });
            };

            initArchiveModeSwitch();
            document.addEventListener("astro:page-load", initArchiveModeSwitch);
        </script>
    )
}
