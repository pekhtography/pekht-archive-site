---
import BackButton from "./BackButton.astro";
import { sitePath } from "@/lib/site-url";

const { url, heading, description, variant, archiveMode } = Astro.props;
---

<div class="border border-border p-6 mt-10 bg-background">
    <BackButton url={url} />
    <h1 class="pt-3 text-5xl font-semibold opacity-90 select-none">{heading}</h1>

    {
        description && (
            <p class={variant === "archive" ? "mt-3 max-w-3xl text-lg text-muted-foreground whitespace-pre-line" : "mt-4 max-w-prose text-base leading-relaxed text-secondary-foreground/80"}>
                {description}
            </p>
        )
    }

    {
        variant === "archive" && archiveMode && (
            <div
                id="archive-mode-switch"
                class="mt-6 grid grid-cols-[minmax(0,1fr)_6rem_6rem] items-center gap-x-2 sm:gap-x-4"
                aria-label="Archive mode"
                data-active-mode={archiveMode}
            >
                <div class="relative min-w-0 h-9 overflow-hidden text-right text-sm">
                    <span
                        data-mode-description="explore"
                        class:list={[
                            "absolute inset-y-0 right-0 flex w-full items-center justify-end text-right transition-all duration-200",
                            archiveMode === "explore"
                                ? "translate-x-0 opacity-100 text-foreground"
                                : "translate-x-2 opacity-0 text-muted-foreground/50",
                        ]}
                    >
                        From the everyday to the once noticed
                    </span>
                    <span
                        data-mode-description="az"
                        class:list={[
                            "absolute inset-y-0 right-0 flex w-full items-center justify-end text-right transition-all duration-200",
                            archiveMode === "az"
                                ? "translate-x-0 opacity-100 text-foreground"
                                : "translate-x-2 opacity-0 text-muted-foreground/50",
                        ]}
                    >
                        A passage through a range of things
                    </span>
                </div>

                <a
                    data-mode-link="explore"
                    href={sitePath("/archive/explore")}
                    aria-current={archiveMode === "explore" ? "page" : undefined}
                    class:list={[
                        "archive-mode-link inline-flex h-9 w-24 items-center justify-center justify-self-end rounded-[min(var(--radius-md),10px)] px-3 text-sm transition-all duration-200",
                        archiveMode === "explore"
                            ? "bg-secondary text-secondary-foreground"
                            : "border border-border bg-background text-muted-foreground hover:bg-secondary/50 hover:text-foreground",
                    ]}
                >
                    <span
                        data-mode-label="explore"
                        class:list={[
                            "transition-all duration-200",
                            archiveMode === "explore"
                                ? "translate-x-0 opacity-100"
                                : "translate-x-2 opacity-0",
                        ]}
                    >
                        Explore
                    </span>
                </a>

                <a
                    data-mode-link="az"
                    href={sitePath("/archive")}
                    aria-current={archiveMode === "az" ? "page" : undefined}
                    class:list={[
                        "archive-mode-link inline-flex h-9 w-24 items-center justify-center justify-self-end rounded-[min(var(--radius-md),10px)] px-3 text-sm transition-all duration-200",
                        archiveMode === "az"
                            ? "bg-secondary text-secondary-foreground"
                            : "border border-border bg-background text-muted-foreground hover:bg-secondary/50 hover:text-foreground",
                    ]}
                >
                    <span
                        data-mode-label="az"
                        class:list={[
                            "transition-all duration-200",
                            archiveMode === "az"
                                ? "translate-x-0 opacity-100"
                                : "translate-x-2 opacity-0",
                        ]}
                    >
                        A–Z
                    </span>
                </a>
            </div>
        )
    }
</div>

{
    variant === "archive" && archiveMode && (
        <script define:vars={{ archiveMode }}>
            const initArchiveModeSwitch = () => {
                const switcher = document.querySelector("#archive-mode-switch");
                if (!(switcher instanceof HTMLElement)) return;

                const activeMode = switcher.dataset.activeMode;
                if (!activeMode) return;

                const links = Array.from(
                    switcher.querySelectorAll("[data-mode-link]"),
                ).filter((element): element is HTMLAnchorElement => element instanceof HTMLAnchorElement);

                const descriptions = Array.from(
                    switcher.querySelectorAll("[data-mode-description]"),
                ).filter((element): element is HTMLElement => element instanceof HTMLElement);

                const labels = Array.from(
                    switcher.querySelectorAll("[data-mode-label]"),
                ).filter((element): element is HTMLElement => element instanceof HTMLElement);

                if (links.length !== 2 || descriptions.length !== 2 || labels.length !== 2) return;

                const getMode = (element: Element) => element.getAttribute("data-mode-link");

                const setPreview = (mode: string) => {
                    if (mode === activeMode) return;

                    links.forEach((link) => {
                        const isPreview = getMode(link) === mode;
                        const isActive = getMode(link) === activeMode;

                        link.classList.toggle("bg-secondary/50", isPreview);
                        link.classList.toggle("text-foreground", isPreview);
                        link.classList.toggle("bg-secondary", false);
                        link.classList.toggle("bg-background", !isPreview && !isActive);
                        link.classList.toggle("border", !isActive);
                        link.classList.toggle("border-border", !isActive);
                    });

                    descriptions.forEach((description) => {
                        const isPreview = description.dataset.modeDescription === mode;
                        description.classList.toggle("translate-x-0", isPreview);
                        description.classList.toggle("opacity-100", isPreview);
                        description.classList.toggle("translate-x-2", !isPreview);
                        description.classList.toggle("opacity-0", !isPreview);
                    });

                    labels.forEach((label) => {
                        const isActive = label.dataset.modeLabel === activeMode;
                        label.classList.toggle("translate-x-0", !isActive);
                        label.classList.toggle("opacity-100", !isActive);
                        label.classList.toggle("translate-x-2", isActive);
                        label.classList.toggle("opacity-0", isActive);
                    });
                };

                const reset = () => {
                    links.forEach((link) => {
                        const mode = getMode(link);
                        const isActive = mode === activeMode;

                        link.classList.toggle("bg-secondary", isActive);
                        link.classList.toggle("text-secondary-foreground", isActive);
                        link.classList.toggle("bg-background", !isActive);
                        link.classList.toggle("text-muted-foreground", !isActive);
                        link.classList.toggle("bg-secondary/50", false);
                        link.classList.toggle("text-foreground", false);
                        link.classList.toggle("border", !isActive);
                        link.classList.toggle("border-border", !isActive);
                    });

                    descriptions.forEach((description) => {
                        const isActive = description.dataset.modeDescription === activeMode;
                        description.classList.toggle("translate-x-0", isActive);
                        description.classList.toggle("opacity-100", isActive);
                        description.classList.toggle("translate-x-2", !isActive);
                        description.classList.toggle("opacity-0", !isActive);
                    });

                    labels.forEach((label) => {
                        const isActive = label.dataset.modeLabel === activeMode;
                        label.classList.toggle("translate-x-0", isActive);
                        label.classList.toggle("opacity-100", isActive);
                        label.classList.toggle("translate-x-2", !isActive);
                        label.classList.toggle("opacity-0", !isActive);
                    });
                };

                links.forEach((link) => {
                    link.addEventListener("pointerenter", (event) => {
                        if (event.pointerType === "mouse") {
                            setPreview(getMode(link) ?? "");
                        }
                    });
                });

                switcher.addEventListener("pointerleave", (event) => {
                    if (event.pointerType === "mouse") {
                        reset();
                    }
                });

                reset();

                requestAnimationFrame(() => {
                    const activeLabel = labels.find(
                        (label) => label.dataset.modeLabel === activeMode,
                    );
                    const activeDescription = descriptions.find(
                        (description) => description.dataset.modeDescription === activeMode,
                    );

                    [activeLabel, activeDescription].forEach((element) => {
                        if (!element) return;
                        element.classList.add("translate-x-2", "opacity-0");
                        requestAnimationFrame(() => {
                            element.classList.remove("translate-x-2", "opacity-0");
                            element.classList.add("translate-x-0", "opacity-100");
                        });
                    });
                });
            };

            initArchiveModeSwitch();
            document.addEventListener("astro:page-load", initArchiveModeSwitch);
        </script>
    )
}
