{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pekhtography.local/portfolio-lifecycle-amendment-1/schemas/global-comparison-stage1.schema.json",
  "title": "Portfolio Lifecycle Amendment 1 Global Comparison Stage 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_sha256", "candidate_pool_ids", "evaluations", "preliminary_finalists"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_pool_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^cand_[a-f0-9]{64}$" }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "criteria", "blocking_issues"],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^cand_[a-f0-9]{64}$" },
          "criteria": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "score", "rationale", "evidence"],
              "properties": {
                "criterion": {
                  "enum": ["semantic_coherence", "curatorial_originality", "narrative_integrity", "evidence_integrity", "visual_composition_potential"]
                },
                "score": { "type": "integer", "minimum": 1, "maximum": 5 },
                "rationale": { "type": "string", "minLength": 1 },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "observation_id"],
                        "properties": {
                          "kind": { "const": "OBSERVATION" },
                          "observation_id": { "type": "string", "minLength": 1, "maxLength": 260 }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "source_id"],
                        "properties": {
                          "kind": { "const": "SOURCE_IMAGE" },
                          "source_id": { "type": "string", "minLength": 1, "maxLength": 128 }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "blocking_issues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "preliminary_finalists": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^cand_[a-f0-9]{64}$" }
    }
  }
}