{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pekhtography.local/schemas/independent-test-response-v1.3.2.schema.json",
  "title": "Portfolio Independent TEST Response v1.3.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "decision", "scores", "findings", "blocking_issues"],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^cand_[a-f0-9]{64}$" },
    "decision": { "enum": ["APPROVE", "REJECT"] },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_coherence", "curatorial_originality", "narrative_integrity", "visual_composition", "evidence_integrity"],
      "properties": {
        "semantic_coherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "curatorial_originality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "narrative_integrity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "visual_composition": { "type": "integer", "minimum": 1, "maximum": 5 },
        "evidence_integrity": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "issue", "blocking", "evidence"],
        "properties": {
          "criterion": {
            "enum": ["semantic_coherence", "curatorial_originality", "narrative_integrity", "visual_composition", "evidence_integrity"]
          },
          "issue": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "blocking": { "type": "boolean" },
          "evidence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "source_id", "quote"],
                "properties": {
                  "kind": { "const": "SOURCE" },
                  "source_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "quote": { "type": "string", "minLength": 1, "pattern": "\\S" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path", "quote"],
                "properties": {
                  "kind": { "const": "COMPOSITION" },
                  "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)+$" },
                  "quote": { "type": "string", "minLength": 1, "pattern": "\\S" }
                }
              }
            ]
          }
        }
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "APPROVE" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "scores": {
            "properties": {
              "semantic_coherence": { "minimum": 4 },
              "curatorial_originality": { "minimum": 4 },
              "narrative_integrity": { "minimum": 4 },
              "visual_composition": { "minimum": 4 },
              "evidence_integrity": { "const": 5 }
            }
          },
          "blocking_issues": { "maxItems": 0 },
          "findings": { "not": { "contains": { "properties": { "blocking": { "const": true } }, "required": ["blocking"] } } }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "REJECT" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "blocking_issues": { "minItems": 1 },
          "findings": { "contains": { "properties": { "blocking": { "const": true } }, "required": ["blocking"] } }
        }
      }
    }
  ]
}
