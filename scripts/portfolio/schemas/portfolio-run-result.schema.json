{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "input_snapshot",
    "gemini_output",
    "validation",
    "model_used"
  ],
  "properties": {
    "status": {
      "enum": [
        "APPROVED",
        "NO_GALLERY",
        "INCOMPLETE"
      ]
    },
    "input_snapshot": {
      "$ref": "#/$defs/inputSnapshot"
    },
    "gemini_output": {
      "oneOf": [
        {
          "$ref": "gemini-output.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "model_used": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelCall"
      }
    },
    "composition": {
      "oneOf": [
        {
          "$ref": "gemini-gallery.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_test": {
      "oneOf": [
        {
          "$ref": "independent-test-response-v1.3.2.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateResult"
      }
    }
  },
  "$defs": {
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository_commit",
        "generated_at",
        "sampled_count",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "sampled_count": {
          "const": 1000
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "structural",
        "semantic",
        "process",
        "findings"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/validationStatus"
        },
        "structural": {
          "$ref": "#/$defs/validationStatus"
        },
        "semantic": {
          "$ref": "#/$defs/validationStatus"
        },
        "process": {
          "$ref": "#/$defs/validationStatus"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "validationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "severity",
        "message"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "stage",
        "candidate_id",
        "model",
        "fallback_index",
        "attempts",
        "outcome"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "DISCOVER",
            "COMPOSE",
            "TEST",
            "REVISION"
          ]
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "fallback_index": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "SUCCESS",
            "FALLBACK",
            "FAILED"
          ]
        }
      }
    },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "status",
        "composition",
        "independent_test",
        "revision_cycles",
        "findings"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "REVISION_EXHAUSTED",
            "INCOMPLETE"
          ]
        },
        "composition": {
          "oneOf": [
            {
              "$ref": "gemini-gallery.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_test": {
          "oneOf": [
            {
              "$ref": "independent-test-response-v1.3.2.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gemini_output": {
            "type": "object",
            "properties": {
              "gallery": {
                "type": "object"
              },
              "test": {
                "properties": {
                  "decision": {
                    "const": "APPROVE"
                  }
                }
              }
            }
          },
          "validation": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "structural": {
                "const": "PASS"
              },
              "semantic": {
                "const": "PASS"
              },
              "process": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_GALLERY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gemini_output": {
            "type": "object",
            "properties": {
              "gallery": {
                "type": "null"
              },
              "test": {
                "properties": {
                  "decision": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          "validation": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "structural": {
                "const": "PASS"
              },
              "semantic": {
                "const": "PASS"
              },
              "process": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "NOT_RUN"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
