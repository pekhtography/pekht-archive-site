{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone Portfolio Gemini Gallery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ids",
    "title",
    "statement",
    "facets",
    "roles",
    "composition_rationale",
    "alternatives_considered",
    "doubts"
  ],
  "properties": {
    "source_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "facets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "composition_rationale": {
      "type": "string",
      "minLength": 1
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doubts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "title",
        "statement",
        "facets",
        "roles",
        "composition_rationale",
        "alternatives_considered",
        "doubts"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "facets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "composition_rationale": {
          "type": "string",
          "minLength": 1
        },
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "doubts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "operation",
        "evidence",
        "necessity"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "necessity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "interpretation"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "findings",
        "revision_cycles"
      ],
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
